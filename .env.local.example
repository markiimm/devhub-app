# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API, em supabase.com).

NEXT_PUBLIC_SUPABASE_URL=https://pvelivifquufmsbaiohc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_DDCKTnaUKopynyB415HamQ_qHJQeQEs

# Opcional — só necessário se for usar o webhook da Stripe pra sincronizar assinaturas
# (Project Settings → API → service_role key). NUNCA use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional — plano Pro via Stripe (dashboard.stripe.com → Developers → API keys).
# Sem essas três, a página /pricing mostra "em breve" e nada quebra.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PRO=
# Preenchido depois de registrar o endpoint /api/webhooks/stripe na Stripe
# (ou rodando `stripe listen` localmente).
STRIPE_WEBHOOK_SECRET=
